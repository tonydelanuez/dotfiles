#!/usr/bin/env zsh

set -euo pipefail

DOTFILES_DIR="${0:A:h:h}"

die() {
  print -u2 "error: $*"
  exit 1
}

link_file() {
  local source="$1"
  local target="$2"

  mkdir -p "${target:h}"

  if [[ -L "$target" && "$(readlink "$target")" == "$source" ]]; then
    return
  fi

  if [[ -e "$target" || -L "$target" ]]; then
    local backup="$target.dotfiles-backup.$(date +%Y%m%d%H%M%S)"
    print "Backing up $target -> $backup"
    mv "$target" "$backup"
  fi

  ln -s "$source" "$target"
  print "Linked $target"
}

install_font() {
  local source="$1"
  local target="$2"

  mkdir -p "${target:h}"

  if [[ -f "$target" ]] && cmp -s "$source" "$target"; then
    return
  fi

  if [[ -e "$target" || -L "$target" ]]; then
    local backup="$target.dotfiles-backup.$(date +%Y%m%d%H%M%S)"
    print "Backing up $target -> $backup"
    mv "$target" "$backup"
  fi

  cp "$source" "$target"
  print "Installed font $target"
}

if ! command -v brew >/dev/null 2>&1; then
  die "Homebrew is required. Install it from https://brew.sh and run this again."
fi

print "Installing Homebrew dependencies..."
brew bundle --file="$DOTFILES_DIR/Brewfile"

# --- Shell ---
link_file "$DOTFILES_DIR/.zshrc"        "$HOME/.zshrc"
link_file "$DOTFILES_DIR/.zsh_aliases"  "$HOME/.zsh_aliases"
link_file "$DOTFILES_DIR/.ssh_agent"    "$HOME/.ssh_agent"
link_file "$DOTFILES_DIR/.scripts"      "$HOME/.scripts"

# --- Terminal ---
link_file "$DOTFILES_DIR/config/ghostty"    "$HOME/.config/ghostty"
link_file "$DOTFILES_DIR/config/herdr"      "$HOME/.config/herdr"

# --- Bar ---
link_file "$DOTFILES_DIR/config/sketchybar" "$HOME/.config/sketchybar"

# Compile the CoreGraphics space-query helper (replaces yabai -m query)
HELPER_SRC="$HOME/.config/sketchybar/helpers/query_spaces.m"
HELPER_BIN="$HOME/.config/sketchybar/helpers/query_spaces"
if [ -f "$HELPER_SRC" ] && [ "$HELPER_SRC" -nt "$HELPER_BIN" ]; then
  print "Compiling query_spaces helper…"
  clang -framework Foundation -framework CoreGraphics -framework AppKit \
        -fobjc-arc -O2 -o "$HELPER_BIN" "$HELPER_SRC" || true
fi

# --- Other ---
link_file "$DOTFILES_DIR/config/vx"         "$HOME/.vx"

# --- WM ---
# Amethyst stores prefs in macOS defaults — no config file needed
open -a Amethyst 2>/dev/null || true

# --- Fonts ---
if [[ -d "$HOME/Library/Fonts" ]]; then
  install_font "$DOTFILES_DIR/fonts/sketchybar-app-font.ttf" \
               "$HOME/Library/Fonts/sketchybar-app-font.ttf"
fi

# --- Services ---
brew services restart sketchybar 2>/dev/null || brew services start sketchybar
sleep 1
sketchybar --reload 2>/dev/null || true
herdr server reload-config 2>/dev/null || true

print ""
print "Dotfiles installed from $DOTFILES_DIR"
print "Ensure Amethyst has Accessibility permissions if windows aren't tiling."
