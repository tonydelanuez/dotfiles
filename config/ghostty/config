# ── Omarchy "Matte Black" — DHH-style terminal ricing ─────────────
# https://github.com/tahayvr/omarchy-matte-black

# ── Typography ──────────────────────────────────────────────────────
font-size = 16
font-family = SF Mono
font-feature = calt
bold-is-bright = true

# ── Canvas (generous padding = the framed "matte" look) ─────────────
window-padding-x = 24
window-padding-y = 20
background = #121212
foreground = #BEBEBE

# ── Cursor ──────────────────────────────────────────────────────────
cursor-style = bar
cursor-style-blink = true
cursor-color = #FFC107
cursor-text = #121212

# ── Selection ───────────────────────────────────────────────────────
selection-background = #333333
selection-foreground = #EAEAEA

# ── Window chrome (minimal — let the terminal be the canvas) ────────
window-theme = dark
macos-titlebar-style = transparent
# client-side decorations = no native macOS tab icons
window-decoration = client

# ── Palette (matte black + amber accent) ────────────────────────────
palette = 0=#333333
palette = 1=#D35F5F
palette = 2=#FFC107
palette = 3=#B91C1C
palette = 4=#E68E0D
palette = 5=#D35F5F
palette = 6=#BEBEBE
palette = 7=#BEBEBE
palette = 8=#8A8A8D
palette = 9=#B91C1C
palette = 10=#FFC107
palette = 11=#B90A0A
palette = 12=#F59E0B
palette = 13=#B91C1C
palette = 14=#EAEAEA
palette = 15=#FFFFFF

# ── Misc ────────────────────────────────────────────────────────────
confirm-close-surface = false
